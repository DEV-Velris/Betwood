generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GroupVisibility {
  PUBLIC
  PRIVATE
}

enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  sessions           Session[]
  accounts           Account[]
  PronoGroup         PronoGroup[]
  PronoGroupMember   PronoGroupMember[]
  GlobalChampionPick GlobalChampionPick[]
  HotSawPick         HotSawPick[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

model Athlete {
  id          String    @id @default(cuid())
  firstName   String
  lastName    String
  countryCode String?
  birthDate   DateTime?
  biography   String?
  specialty   String? // Spécialité principale (ex: "Axe", "Hot Saw", "Chainsaw")
  achievements String? // Palmarès en JSON ou texte
  personalRecords String? // Records personnels en JSON ou texte
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  champions          CompetitionResult[]  @relation("champions")
  hotSawWins         CompetitionResult[]  @relation("hotSawWinner")
  GlobalChampionPick GlobalChampionPick[]
  HotSawPick         HotSawPick[]
}

model Competition {
  id        String    @id @default(cuid())
  name      String
  startAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  CompetitionResults CompetitionResult[]
  PronoGroup         PronoGroup[]
  GlobalChampionPick GlobalChampionPick[]
  HotSawPick         HotSawPick[]
}

model CompetitionResult {
  id                String    @id @default(cuid())
  competitionId     String    @unique
  championAthleteId String?
  hotSawWinnerId    String?
  publishedAt       DateTime?

  competition  Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  champion     Athlete?    @relation("champions", fields: [championAthleteId], references: [id], onDelete: Cascade)
  hotSawWinner Athlete?    @relation("hotSawWinner", fields: [hotSawWinnerId], references: [id], onDelete: Cascade)
}

model PronoGroup {
  id            String          @id @default(cuid())
  name          String
  visibility    GroupVisibility @default(PRIVATE)
  ownerId       String
  competitionId String
  inviteCode    String          @unique
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @default(now()) @updatedAt

  owner       User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  competition Competition        @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  members     PronoGroupMember[]
}

model PronoGroupMember {
  groupId  String
  userId   String
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  group PronoGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
}

model GlobalChampionPick {
  id            String    @id @default(cuid())
  userId        String
  competitionId String
  athleteId     String
  lockedAt      DateTime?
  createdAt     DateTime  @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  athlete     Athlete     @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([userId, competitionId])
}

model HotSawPick {
  id            String    @id @default(cuid())
  userId        String
  competitionId String
  athleteId     String
  lockedAt      DateTime?
  createdAt     DateTime  @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  athlete     Athlete     @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([userId, competitionId])
}
